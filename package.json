{
  "name": "voraworld-id",
  "version": "2.0.0",
  "private": true,
  "description": "VORA corporate website, CMS and business portal (Next.js + Supabase)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:http": "next build && vitest run -c vitest.http.config.ts",
    "test:e2e": "next build && playwright test",
    "db:migrate": "tsx scripts/apply-migrations.ts",
    "build:setup-sql": "tsx scripts/build-manual-setup.ts",
    "gen:schema": "tsx scripts/gen-schema-types.ts",
    "build:pdf-assets": "tsx scripts/embed-pdf-assets.ts"
  },
  "dependencies": {
    "@remotion/paths": "4.0.539",
    "@remotion/player": "4.0.539",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "15.5.28",
    "nodemailer": "6.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "remotion": "4.0.539",
    "sanitize-html": "2.18.1",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.24",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
