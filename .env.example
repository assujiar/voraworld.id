# VORA environment variables. Copy to .env for local development (FastAPI does not load .env by itself:
# export the variables or use direnv/dotenv). NEVER commit real values; on Vercel set them in Project Settings.
# Sensitive values (marked SECRET) must be added as "Sensitive" variables and never exposed to browser code.

# ---- Core (required) --------------------------------------------------------
# development: SQLite allowed, local uploads, API docs on. production: PostgreSQL + HTTPS + strong secret enforced.
# Vercel deployments (staging included) MUST use APP_ENV=production.
APP_ENV=development
# SECRET. Local: sqlite:///./vora.db . Vercel/Supabase: the Supabase *transaction pooler* URI (port 6543):
# postgresql://postgres.<PROJECT_REF>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./vora.db
# SECRET, 32+ random characters: openssl rand -hex 32 . Rotating it signs every admin out.
SESSION_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
# Canonical public origin, https in production. Embedded in document QR codes and emails: use the permanent domain.
PUBLIC_BASE_URL=http://127.0.0.1:8765

# ---- Supabase Storage (required in production) ------------------------------
SUPABASE_URL=
# SECRET, server-side only. Never prefix with NEXT_PUBLIC_ and never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for website/article images.
SUPABASE_STORAGE_BUCKET=vora-media
# PRIVATE bucket for stamped receipts and signed quotation approvals.
SUPABASE_DOCUMENTS_BUCKET=vora-documents

# ---- Email (SMTP host/user/password are entered in the admin portal, not here) -
# SECRET. Encrypts the SMTP password stored in the database:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up: losing or changing it makes the saved SMTP password unreadable.
MAIL_ENCRYPTION_KEY=
# SECRET, 32+ random characters. Authorises GET /internal/mail/dispatch (Vercel Cron sends it automatically).
CRON_SECRET=

# ---- Optional tuning --------------------------------------------------------
# Upload ceiling in bytes. Default 10485760 (10 MiB); 4000000 on Vercel (platform request limit is 4.5 MB).
MAX_UPLOAD_BYTES=
# Set to 1 to disable SQLAlchemy connection pooling (automatic on Vercel).
DB_NULL_POOL=

# ---- Development and tests only ---------------------------------------------
# Local directory for private PDFs when APP_ENV is not production (default ./protected).
VORA_LOCAL_PRIVATE_DIR=
# Skip the development-only schema bootstrap so a migrated database is used exactly as it is.
VORA_SKIP_INIT_DB=
# Run the whole test-suite against a freshly migrated PostgreSQL database.
VORA_TEST_DATABASE_URL=
