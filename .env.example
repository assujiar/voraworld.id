# VORA local development. Do not commit real credentials.
APP_ENV=development
DATABASE_URL=sqlite:///./vora.db
SESSION_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
PUBLIC_BASE_URL=http://127.0.0.1:8765

# Production configuration (Vercel + Supabase)
# APP_ENV=production
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<SUPABASE_POSTGRES_POOLER_HOST>:6543/postgres?sslmode=require
# PUBLIC_BASE_URL=https://staging.example.com
# SESSION_SECRET=<openssl rand -hex 32>
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vora-media

# Optional integrations not enabled without provider setup
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
GA4_MEASUREMENT_ID=

# Custom SMTP is set in the Admin portal; only the encryption key remains server-side.
# Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_ENCRYPTION_KEY=
# Private bucket for e-meterai receipts and customer-approved quotation PDFs.
SUPABASE_DOCUMENTS_BUCKET=vora-documents
# Optional scheduler to retry failed/queued emails, 32+ characters, never exposed.
CRON_SECRET=
