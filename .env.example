# VORA environment variables.
# Local development: copy this file to `.env.local` (Next.js loads it automatically) and fill in DATABASE_URL.
# Vercel: set the same names in Project -> Settings -> Environment Variables (mark secrets as "Sensitive").
# NEVER commit real values. Secrets are used on the server only and never reach browser code.
# Variables the platform sets itself (NODE_ENV, VERCEL, NEXT_RUNTIME) are not listed.

# ---- Core (required) --------------------------------------------------------
# development: plain-http base URL and local file storage are allowed.
# production: https PUBLIC_BASE_URL, a strong SESSION_SECRET and Supabase Storage are enforced; the server refuses to start otherwise.
# A Vercel deployment (preview or production) must use APP_ENV=production.
APP_ENV=development

# SECRET. A PostgreSQL connection string.
# Local:    postgresql://postgres:postgres@localhost:5432/vora
# Supabase: the *transaction pooler* URI (port 6543) for the running app:
#   postgresql://postgres.<PROJECT_REF>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Use the *session pooler* (port 5432) or the direct connection for `npm run db:migrate` and `npm run users`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vora

# SECRET, 32+ random characters (`openssl rand -hex 32`). Signs admin sessions. Rotating it signs everyone out.
# A value starting with "replace-" is refused in production.
SESSION_SECRET=replace-with-a-long-random-value-0123456789abcdef

# The final public origin, https in production, no trailing slash. It is printed into the QR code of every invoice,
# receipt and quotation and into emails: set the permanent domain BEFORE issuing the first real document.
PUBLIC_BASE_URL=http://localhost:3000

# ---- Supabase Storage (required in production) ------------------------------
# https://<PROJECT_REF>.supabase.co
SUPABASE_URL=
# SECRET, server-side only: the `sb_secret_...` key (or the legacy service_role key). Never the publishable/anon key.
SUPABASE_SERVICE_ROLE_KEY=
# PUBLIC bucket for website and article images.
SUPABASE_STORAGE_BUCKET=vora-media
# PRIVATE bucket for stamped receipts and customer-signed quotations. It must stay private.
SUPABASE_DOCUMENTS_BUCKET=vora-documents

# ---- Email (the SMTP host, user and password are entered in the admin portal, not here) ---
# SECRET. Encrypts the SMTP password that is stored in the database: exactly 32 random bytes, base64 encoded.
#   openssl rand -base64 32
# Back it up. Losing or changing it makes the saved SMTP password unreadable (just enter it again).
MAIL_ENCRYPTION_KEY=
# SECRET, 32+ random characters (`openssl rand -hex 32`). Authorises GET /internal/mail/dispatch; Vercel Cron sends it
# automatically as `Authorization: Bearer <CRON_SECRET>`. Without it the endpoint answers 401 to everyone.
CRON_SECRET=

# ---- Optional tuning --------------------------------------------------------
# Upload ceiling in bytes. Default 10485760 (10 MiB), or 4000000 on Vercel, whose request limit is 4.5 MB.
MAX_UPLOAD_BYTES=
# Largest number of database connections one server instance opens (default 10). Ignored on Vercel, which always uses 1
# per function instance because the Supabase pooler already multiplexes connections.
DB_POOL_MAX=

# ---- Development and tests only ---------------------------------------------
# Directory used instead of Supabase Storage when SUPABASE_URL is empty and APP_ENV is not production (default ./.local-storage).
VORA_LOCAL_STORAGE_DIR=
# A PostgreSQL *server* URL with permission to create databases: the test suite builds throw-away databases there.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
